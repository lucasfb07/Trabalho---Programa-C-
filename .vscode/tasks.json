{
    // Ctrl+Shift+B: compila o executor em build\ e roda os quatro algoritmos.
    // Usa o gcc se estiver no PATH; senão, o cl (MSVC, pelo Developer Command Prompt).
    // Se já houver um rodar_todos.exe rodando, avisa em vez de recompilar por cima dele.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar o executor",
            "type": "shell",
            "command": "tasklist /fi \"imagename eq rodar_todos.exe\" /nh | find /i \"rodar_todos.exe\" >nul && (echo ERRO: ja existe um rodar_todos.exe rodando. Espere ele terminar ou feche-o antes de compilar de novo. & exit 1) & (if not exist build mkdir build) & where gcc >nul 2>nul & if errorlevel 1 (cl /nologo /O2 /std:c11 rodar_todos.c /Fo\"build\\\\\" /Fe\"build\\rodar_todos.exe\") else (gcc -O2 -std=c11 rodar_todos.c -o build\\rodar_todos.exe)",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": ["$msCompile", "$gcc"]
        },
        {
            "label": "Compilar e executar todos os algoritmos",
            "type": "shell",
            "command": "build\\rodar_todos.exe",
            "dependsOn": "Compilar o executor",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            // Roda só o algoritmo do arquivo .c aberto (src/<nome>.c).
            "label": "Compilar e executar o algoritmo aberto",
            "type": "shell",
            "command": "build\\rodar_todos.exe ${fileBasenameNoExtension}",
            "dependsOn": "Compilar o executor",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
